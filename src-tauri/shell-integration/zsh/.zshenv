# Branchdial shell integration for zsh (ZDOTDIR shim). Generated by Branchdial.
# Each shim file loads your real file with ZDOTDIR pointing at your directory,
# then points ZDOTDIR back here so zsh reads the next shim file.
__rb_shim_dir=$ZDOTDIR
ZDOTDIR=${BRANCHDIAL_USER_ZDOTDIR:-$HOME}
unset BRANCHDIAL_USER_ZDOTDIR
[[ -f $ZDOTDIR/.zshenv ]] && . "$ZDOTDIR/.zshenv"
__rb_user_zdotdir=$ZDOTDIR
ZDOTDIR=$__rb_shim_dir
