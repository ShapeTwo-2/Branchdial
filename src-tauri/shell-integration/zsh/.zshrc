# Branchdial shell integration for zsh. Generated by Branchdial.
ZDOTDIR=$__rb_user_zdotdir
[[ -f $ZDOTDIR/.zshrc ]] && . "$ZDOTDIR/.zshrc"
__rb_user_zdotdir=$ZDOTDIR

# Reports the last exit code and cwd via an invisible escape sequence (OSC 6973).
typeset -g __rb_nonce="$BRANCHDIAL_NONCE"
unset BRANCHDIAL_NONCE
__rb_precmd() {
  local ec=$?
  printf '\033]6973;P;%s;%s;%s\007' "$__rb_nonce" "$ec" "$PWD"
  return $ec
}
if [[ -n $__rb_nonce ]]; then
  # First in the list so it sees the real exit code.
  precmd_functions=(__rb_precmd $precmd_functions)
fi

if [[ -o login ]]; then
  ZDOTDIR=$__rb_shim_dir   # .zlogin still to come; it restores ZDOTDIR
else
  ZDOTDIR=$__rb_user_zdotdir
  unset __rb_shim_dir __rb_user_zdotdir
fi
