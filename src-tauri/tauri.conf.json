{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchdial",
  "version": "1.0.0",
  "identifier": "dev.branchdial.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Branchdial",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 420,
        "backgroundColor": "#14161b"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; script-src 'self' 'unsafe-inline' http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A real terminal with one-click git workflow buttons",
    "copyright": "Copyright (c) 2026 Branchdial contributors",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/context-menu.wxs"],
        "componentRefs": ["ExplorerContextMenu"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
